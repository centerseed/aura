{
  "name": "naruvia-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "verify:test-safety": "tsx scripts/verify-test-safety.ts",
    "pretest": "npm run verify:test-safety",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:components": "vitest run tests/components",
    "test:e2e": "vitest run tests/e2e",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "local:dev": "bash ../scripts/local-run.sh dev",
    "local:test": "bash ../scripts/local-run.sh test",
    "local:build": "bash ../scripts/local-run.sh build",
    "local:full": "bash ../scripts/local-run.sh full",
    "deploy:web": "bash ../scripts/deploy-web-firebase.sh production",
    "deploy:web:staging": "bash ../scripts/deploy-web-firebase.sh staging",
    "deploy:backend": "bash ../scripts/deploy-backend-cloudrun.sh production",
    "deploy:backend:staging": "bash ../scripts/deploy-backend-cloudrun.sh staging",
    "deploy:all": "bash ../scripts/deploy-all.sh"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.0.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
