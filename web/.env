# Database - Supabase PostgreSQL (Session Pooler for Prisma migrations)
# 使用 port 5432 (Session mode) 以支援 Prisma db push
# pgbouncer=true: 啟用 Prisma 的 pgbouncer 模式優化
# connection_limit=1: Serverless 環境建議值
DATABASE_URL="postgresql://postgres.jeatbzmznavvjkwilsyn:REDACTED_DB_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

