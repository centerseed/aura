# 測試環境變數範例
# 複製此檔案為 .env.test 並填入實際的測試資料庫連線資訊

# 🚨 重要：測試資料庫必須是獨立的資料庫，絕對不可以是生產資料庫
# DATABASE_URL 必須包含以下其中之一：
# - "_test" (例如：naruvia_test)
# - "localhost" 或 "127.0.0.1"
# - "test.supabase"

# 範例 1: 本地 PostgreSQL 測試資料庫
DATABASE_URL="postgresql://user:password@localhost:5432/naruvia_test"

# 範例 2: Supabase 測試專案（需要另外創建測試專案）
# DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# 範例 3: Docker PostgreSQL 測試容器
# DATABASE_URL="postgresql://postgres:postgres@localhost:54322/naruvia_test"

# Firebase Admin SDK (測試環境使用 mock，不需要真實憑證)
# FIREBASE_PROJECT_ID="test-project"

# Google Gemini API (可使用真實 API key 進行整合測試)
# GEMINI_API_KEY="your-test-api-key"

# 環境標記
NODE_ENV="test"
