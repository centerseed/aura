# 🚨 測試環境專用 - 絕對不可連接到生產資料庫

# 測試資料庫（使用本地開發資料庫）
# 資料庫名稱必須包含 "_test" 或使用 localhost
DATABASE_URL="postgresql://naruvia:naruvia_password@localhost:5432/naruvia_db"

# 環境標記
NODE_ENV="test"

# Firebase Admin SDK (測試環境使用 mock，不需要真實憑證)
FIREBASE_ADMIN_PROJECT_ID="test-project"

# Google Gemini API (使用真實 API key 進行整合測試)
GOOGLE_GENERATIVE_AI_API_KEY="REDACTED_GEMINI_API_KEY"

# API 後端 URL (e2e 測試用)
NEXT_PUBLIC_API_URL="https://zentropy-api-894512935237.asia-east1.run.app"

# Firebase 測試帳號 (用於 e2e 認證測試)
TEST_USER_EMAIL="test@zentropy.cc"
TEST_USER_PASSWORD="123456"

# Firebase Web API Key (從 .env.local 複製)
NEXT_PUBLIC_FIREBASE_API_KEY="REDACTED_FIREBASE_API_KEY"
