# iOS 上架環境變數範本
# 複製此檔案為 .env.ios 並填入真實值
# ⚠️ .env.ios 已被 .gitignore 排除，不會 commit

# Apple ID（你的開發者帳號 Email）
APPLE_ID=your@email.com

# App Store Connect Team ID（在 App Store Connect 右上角可查）
ITC_TEAM_ID=123456789

# Apple Developer Team ID（在 developer.apple.com → Membership 可查）
APPLE_TEAM_ID=XXXXXXXXXX

# App Store Connect API Key JSON 檔案路徑
# 產生方式：App Store Connect → Users → Keys → 新增 API Key
ASC_API_KEY_PATH=/Users/yourname/.appstoreconnect/api_key.json
