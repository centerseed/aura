# Zentropy MCP Server Configuration

# Transport mode: "stdio" or "http"
ZENTROPY_TRANSPORT=stdio

# HTTP server port (only used when ZENTROPY_TRANSPORT=http)
ZENTROPY_MCP_PORT=3100

# Backend API base URL
ZENTROPY_BACKEND_URL=http://localhost:3002

# Access token for stdio mode (obtained via `zentropy auth login`)
# In production, this should be stored in OS Keychain, not in .env
ZENTROPY_ACCESS_TOKEN=your-access-token-here

# OAuth 2.1 Configuration (for HTTP/remote mode)
ZENTROPY_OAUTH_ISSUER=https://auth.zentropy.app
ZENTROPY_OAUTH_CLIENT_ID=your-client-id-here
ZENTROPY_OAUTH_AUDIENCE=https://mcp.zentropy.app

# Logging level: "debug" | "info" | "warn" | "error"
ZENTROPY_LOG_LEVEL=info
