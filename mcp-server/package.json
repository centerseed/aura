{
  "name": "zentropy-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Zentropy MCP Server - Secure interface for external AI to access Zentropy data assets",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zentropy-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport=stdio",
    "start:http": "node dist/index.js --transport=http",
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/index.ts --transport=stdio",
    "dev:http": "tsx src/index.ts --transport=http",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
