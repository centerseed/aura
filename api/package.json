{
  "name": "zentropy-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:mcp": "NODE_OPTIONS='--require /Users/wubaizong/Naruvia/api/preload.cjs' npx tsx watch server.ts",
    "build": "next build",
    "start": "node --import tsx/esm server.ts",
    "start:next-only": "next start -p 3002",
    "deploy": "../scripts/deploy-api.sh",
    "lint": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:remote",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "npm run test:db:setup && vitest run tests/integration/ --exclude '**/remote-*.test.ts'",
    "test:remote": "vitest run tests/integration/remote-readonly.test.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:remote",
    "test:db:setup": "./scripts/setup-test-db.sh",
    "test:db:stop": "./scripts/setup-test-db.sh stop",
    "test:db:clean": "./scripts/setup-test-db.sh clean",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --ui --coverage",
    "test:all:auto": "npm run test:db:setup && npm run test:all",
    "test:calendar-crud": "tsx tests/manual/calendar-crud-test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.37",
    "@ai-sdk/openai": "^3.0.39",
    "@line/bot-sdk": "^10.6.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@prisma/client": "^6.0.0",
    "ai": "^6.0.111",
    "firebase-admin": "^13.6.0",
    "mem0ai": "^2.2.4",
    "naru-agent-js": "^0.1.0",
    "next": "^16.1.4",
    "openai": "^6.25.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "19.2.10",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^20.4.0",
    "prisma": "^6.0.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
