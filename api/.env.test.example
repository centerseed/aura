# 測試環境配置 (.env.test)
#
# ⚠️ 重要：測試必須使用獨立的測試資料庫，絕對不可連接生產資料庫！
#
# 複製此檔案為 .env.test 並填入測試資料庫連接資訊

# 測試資料庫連接（必填）
DATABASE_URL_TEST="postgresql://test:test@localhost:5432/naruvia_test"

# Google Generative AI API Key（測試用）
GOOGLE_GENERATIVE_AI_API_KEY="your-test-api-key"

# ============================================================================
# 如何設置測試資料庫
# ============================================================================
#
# 選項 1: 本地 PostgreSQL（推薦用於開發）
# ---------------------------------
# 1. 安裝 PostgreSQL
# 2. 創建測試資料庫：
#    createdb naruvia_test
# 3. 運行 migrations：
#    DATABASE_URL="postgresql://postgres:password@localhost:5432/naruvia_test" npx prisma migrate deploy
#
# 選項 2: Supabase 測試專案
# ---------------------------------
# 1. 在 Supabase 創建一個測試專案
# 2. 複製資料庫連接字串
# 3. 填入上方 DATABASE_URL_TEST
#
# 選項 3: Docker PostgreSQL
# ---------------------------------
# docker run --name naruvia-test-db \
#   -e POSTGRES_PASSWORD=testpass \
#   -e POSTGRES_DB=naruvia_test \
#   -p 5433:5432 \
#   -d postgres:15
#
# DATABASE_URL_TEST="postgresql://postgres:testpass@localhost:5433/naruvia_test"
