# Calendar CRUD 測試環境變數
# 複製此檔案為 .env.test.local 並填入你的 Firebase Token

# 如何獲取 FIREBASE_TOKEN：
# 1. 訪問 https://zentropy.cc/test-calendar
# 2. 登入後點擊「📋 複製完整 Token」按鈕
# 3. 將複製的 token 貼到下方

FIREBASE_TOKEN="your-firebase-token-here"

# API URL（可選，預設為 https://zentropy.cc/api）
# API_BASE_URL="http://localhost:3002/api"
