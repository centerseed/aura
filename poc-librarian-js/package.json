{
  "name": "poc-librarian-js",
  "version": "1.0.0",
  "description": "Universal Librarian Engine POC - Per-User Learning Validation",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:teardown": "tsx scripts/teardown-db.ts",
    "poc": "tsx scripts/run-poc.ts",
    "poc:baseline": "tsx scripts/run-poc.ts --phase=1",
    "poc:train": "tsx scripts/run-poc.ts --phase=2",
    "poc:evaluate": "tsx scripts/run-poc.ts --phase=3",
    "poc:report": "tsx scripts/run-poc.ts --report-only",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "ai": "^4.0.0",
    "@ai-sdk/google": "^1.0.0",
    "pg": "^8.13.0",
    "dotenv": "^16.4.0",
    "ml-kmeans": "^6.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
