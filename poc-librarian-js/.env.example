# POC Librarian Engine 環境配置
# 複製此檔案為 .env 並填入實際值

# ============================================================================
# 資料庫連線
# ============================================================================

# 本地開發（推薦）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poc_librarian"

# Supabase（僅使用 poc_librarian schema，不影響主系統）
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ============================================================================
# Google AI API
# ============================================================================

# Gemini API Key（用於 Embedding 和 LLM 蒸餾）
GOOGLE_GENERATIVE_AI_API_KEY="your-api-key-here"

# ============================================================================
# 執行環境
# ============================================================================

NODE_ENV="development"

# ============================================================================
# POC 配置（可選）
# ============================================================================

# 每階段輸入數量（預設 10）
POC_INPUTS_PER_PHASE=10

# 蒸餾觸發閾值（預設 10）
POC_DISTILL_THRESHOLD=10

# Clustering 相似度閾值（預設 0.85）
POC_CLUSTERING_THRESHOLD=0.85
