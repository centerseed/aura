# POC Librarian Engine 環境配置
# 複製此檔案為 .env 並填入實際值

# ============================================================================
# 資料庫連線（共用 Naruvia 的 Neon PostgreSQL，使用獨立 poc_librarian schema）
# ============================================================================

# Neon PostgreSQL（推薦，與 api 共用同一資料庫）
DATABASE_URL="postgresql://user:password@your-project.neon.tech/neondb?sslmode=require"

# 本地開發（替代方案）
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poc_librarian"

# ============================================================================
# Google AI API
# ============================================================================

# Gemini API Key（用於 Embedding 和 LLM 蒸餾）
GOOGLE_GENERATIVE_AI_API_KEY="your-api-key-here"

# ============================================================================
# 服務設定
# ============================================================================

# HTTP 服務 Port（Cloud Run 預設 8080）
PORT=8080

# API Key 認證（留空則不驗證，適合本地開發）
LIBRARIAN_API_KEY=""

# ============================================================================
# 執行環境
# ============================================================================

NODE_ENV="development"

# ============================================================================
# POC 配置（可選，僅 CLI 模式使用）
# ============================================================================

# 每階段輸入數量（預設 10）
POC_INPUTS_PER_PHASE=10

# 蒸餾觸發閾值（預設 10）
POC_DISTILL_THRESHOLD=10

# Clustering 相似度閾值（預設 0.85）
POC_CLUSTERING_THRESHOLD=0.85
